# Z - Financial Intel Backend Configuration
# Copy this file to .env and update values

# Application
APP_NAME="Z - Financial Intel"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# API Configuration
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/z_financial_intel
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=60

# JWT Authentication
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Scraper Configuration
SCRAPER_ENABLED=true
SCRAPER_INTERVAL_SECONDS=60
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_RETRY_ATTEMPTS=3

# NSE Configuration
NSE_BASE_URL=https://www.nseindia.com
NSE_API_BASE_URL=https://www.nseindia.com/api

# BSE Configuration
BSE_BASE_URL=https://www.bseindia.com

# Unusual Activity Thresholds
UNUSUAL_VOLUME_MULTIPLIER=3.0
UNUSUAL_PREMIUM_THRESHOLD=10000000.0
UNUSUAL_OI_SPIKE_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
