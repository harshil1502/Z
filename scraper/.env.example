# Z - Financial Intel Scraper Configuration
# Copy this file to .env and update values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/z_financial_intel

# Redis
REDIS_URL=redis://localhost:6379/0

# NSE Configuration
NSE_BASE_URL=https://www.nseindia.com
NSE_API_BASE_URL=https://www.nseindia.com/api

# BSE Configuration
BSE_BASE_URL=https://www.bseindia.com

# Scraper Settings
SCRAPER_INTERVAL_SECONDS=60
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_DELAY=2.0

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_DELAY_BETWEEN_REQUESTS=2.0

# Symbols to Scrape (JSON arrays)
INDEX_SYMBOLS=["NIFTY","BANKNIFTY","FINNIFTY"]
STOCK_SYMBOLS=["RELIANCE","TCS","INFY","HDFCBANK","ICICIBANK"]

# Unusual Activity Thresholds
UNUSUAL_VOLUME_MULTIPLIER=3.0
UNUSUAL_PREMIUM_THRESHOLD=10000000.0
UNUSUAL_OI_SPIKE_THRESHOLD=0.5

# Market Hours (IST)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30

# Logging
LOG_LEVEL=INFO
